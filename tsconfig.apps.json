{
  "$schema": "http://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.base.json",
  "include": [],
  // Add one `{ "path": "apps/<name>" }` per app.
  //
  // Note: a bundler-built frontend (Vite/React) is conventionally a *leaf*, not a project
  // reference -- it sets `composite: false`, `noEmit: true`, `moduleResolution: "bundler"` and
  // is type-checked by its own `tsc -b`, since the bundler resolves workspace deps itself.
  // Only reference apps here if they emit via `tsc` and participate in the composite graph.
  "references": [{ "path": "apps/server" }]
}
