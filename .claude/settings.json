{
  "model": "opus[1m]",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|Skill|SlashCommand|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/boundary-guard.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/block-dangerous-git.sh"
          }
        ]
      },
      {
        "matcher": "Skill|SlashCommand",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/fresh-session-guard.sh"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/fresh-session-guard.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-context.sh"
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-bootstrap.sh",
            "timeout": 600
          }
        ]
      }
    ]
  },
  "enabledPlugins": {},
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    }
  },
  "outputStyle": "Guided",
  "sandbox": {
    "enabled": true,
    "network": {
      "allowedDomains": [
        "cache.nixos.org",
        "channels.nixos.org",
        "flakehub.com",
        "api.flakehub.com",
        "cache.flakehub.com",
        "github.com",
        "api.github.com",
        "codeload.github.com",
        "objects.githubusercontent.com",
        "raw.githubusercontent.com",
        "registry.npmjs.org"
      ],
      "allowUnixSockets": [
        "/nix/var/nix/daemon-socket/socket",
        "/var/run/nix-daemon.socket",
        "/private/var/run/nix-daemon.socket"
      ]
    },
    "filesystem": {
      "allowWrite": [
        "~/.cache/nix",
        "~/.local/state/nix",
        "~/.local/share/nix",
        "~/.cache/pnpm",
        "~/.local/share/pnpm",
        "~/Library/pnpm"
      ]
    }
  },
  "theme": "dark"
}
