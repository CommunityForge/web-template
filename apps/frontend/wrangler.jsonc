{
  // Static-assets Worker for the built SPA. `nix build .#frontend` from this directory leaves the
  // bundle at ./result, which is what gets uploaded.
  // There is no `name` here ON PURPOSE: whatever deploys passes the Worker's name on the command
  // line with `--name`, so a fork never edits this file.
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./result",
    // React Router runs in declarative mode; unknown paths must fall back to index.html.
    "not_found_handling": "single-page-application",
  },
  "workers_dev": true,
  // A version gets a preview URL only while this is on. Only a deploy or `wrangler triggers deploy`
  // applies it to the Worker; `wrangler versions upload` merely reads it.
  "preview_urls": true,
}
